{
  "name": "hertzbeat-web-app",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4200",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "toolchain:check": "node scripts/check-toolchain.mjs && node --test scripts/toolchain-contract.test.mjs scripts/bundle-limits-contract.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "cd .. && git-format-staged -f 'web-app/node_modules/.bin/prettier --config web-app/.prettierrc.cjs --ignore-path web-app/.prettierignore --ignore-unknown --stdin-filepath \"{}\"' 'web-app/*'",
    "diff:check": "cd .. && git diff --check",
    "hooks:install": "git config extensions.worktreeConfig true && git config --worktree core.hooksPath \"$(git rev-parse --show-toplevel)/.githooks\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture": "node --test scripts/dependency-rules.test.mjs scripts/source-conventions.test.mjs && depcruise --config dependency-cruiser.config.cjs --output-type err-long src && node scripts/check-architecture.mjs",
    "i18n:check": "node scripts/check-cjk.mjs",
    "budget": "node scripts/check-bundle.mjs",
    "dead-code": "knip",
    "verify": "pnpm toolchain:check && pnpm architecture && pnpm i18n:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm budget && pnpm dead-code && pnpm diff:check",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then pnpm hooks:install; fi"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@antv/g6": "5.1.1",
    "@refinedev/antd": "6.0.3",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.101.2",
    "antd": "5.29.3",
    "dayjs": "1.11.21",
    "i18next": "26.3.6",
    "lucide-react": "0.511.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.9",
    "react-router": "7.18.1",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "git-format-staged": "4.0.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "knip": "6.26.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
