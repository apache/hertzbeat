{
  "name": "hertzbeat-web-app",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4200",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "toolchain:check": "node scripts/check-toolchain.mjs && node --test scripts/toolchain-contract.test.mjs scripts/bundle-limits-contract.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "cd .. && git-format-staged -f 'web-app/node_modules/.bin/prettier --config web-app/.prettierrc.cjs --ignore-path web-app/.prettierignore --ignore-unknown --stdin-filepath \"{}\"' 'web-app/*'",
    "diff:check": "cd .. && git diff --check",
    "hooks:install": "git config extensions.worktreeConfig true && git config --worktree core.hooksPath \"$(git rev-parse --show-toplevel)/.githooks\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser:install": "playwright install chromium",
    "test:browser": "playwright test",
    "smoke:production": "pnpm build && pnpm test:browser",
    "architecture": "node --test scripts/dependency-rules.test.mjs scripts/perses-boundary-contract.test.mjs scripts/source-conventions.test.mjs && depcruise --config dependency-cruiser.config.cjs --output-type err-long src && node scripts/check-architecture.mjs",
    "i18n:check": "node scripts/check-cjk.mjs",
    "budget": "node scripts/check-bundle.mjs",
    "dead-code": "knip",
    "verify": "pnpm toolchain:check && pnpm architecture && pnpm i18n:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm budget && pnpm dead-code && pnpm diff:check",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then pnpm hooks:install; fi"
  },
  "knip": {
    "ignoreDependencies": [
      "@perses-dev/explore"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@antv/g": "6.3.1",
    "@antv/g6": "5.1.1",
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.2",
    "@codemirror/merge": "6.12.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.41.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "3.10.0",
    "@lezer/highlight": "1.2.3",
    "@mui/material": "6.5.0",
    "@mui/x-data-grid": "7.29.13",
    "@perses-dev/client": "0.54.0",
    "@perses-dev/components": "0.54.0",
    "@perses-dev/dashboards": "0.54.0",
    "@perses-dev/explore": "0.54.0",
    "@perses-dev/gauge-chart-plugin": "0.13.0",
    "@perses-dev/logs-table-plugin": "0.3.0",
    "@perses-dev/plugin-system": "0.54.0",
    "@perses-dev/spec": "0.2.0",
    "@perses-dev/stat-chart-plugin": "0.14.0",
    "@perses-dev/table-plugin": "0.13.0",
    "@perses-dev/timeseries-chart-plugin": "0.13.0",
    "@perses-dev/trace-table-plugin": "0.11.0",
    "@perses-dev/tracing-gantt-chart-plugin": "0.13.0",
    "@phosphor-icons/core": "2.1.1",
    "@refinedev/antd": "6.0.3",
    "@refinedev/core": "5.0.12",
    "@refinedev/react-router": "2.0.4",
    "@tanstack/react-query": "5.101.2",
    "antd": "5.29.3",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dayjs": "1.11.21",
    "devicon": "2.17.0",
    "echarts": "5.5.0",
    "i18next": "26.3.6",
    "immer": "10.2.0",
    "lodash": "4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "2.2.3",
    "react-hook-form": "7.62.0",
    "react-i18next": "17.0.9",
    "react-router": "7.18.1",
    "react-router-dom": "7.18.1",
    "use-resize-observer": "9.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/lodash": "4.17.20",
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "git-format-staged": "4.0.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "knip": "6.26.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
