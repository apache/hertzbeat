# Bind HertzBeat's web/API listener (1157) and manager/collector transport
# (1158) to loopback for a local quick start. Set this to a reachable manager
# address only when remote access is required and network controls are ready.
HERTZBEAT_BIND_ADDRESS=127.0.0.1
