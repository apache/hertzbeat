FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

ARG TARGETARCH

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates libstdc++6 tzdata zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system hertzbeat \
    && useradd --system --gid hertzbeat --home-dir /opt/hertzbeat-collector hertzbeat

ADD collector-native-linux-${TARGETARCH}.tar.gz /opt/

RUN package_dir="$(find /opt -mindepth 1 -maxdepth 1 -type d -name 'apache-hertzbeat-collector-native-*-linux-*-bin' -print -quit)" \
    && test -n "$package_dir" \
    && mv "$package_dir" /opt/hertzbeat-collector \
    && mkdir -p /opt/hertzbeat-collector/data /opt/hertzbeat-collector/logs \
    && chown -R hertzbeat:hertzbeat /opt/hertzbeat-collector

ENV LANG=C.UTF-8
ENV TZ=UTC

WORKDIR /opt/hertzbeat-collector
USER hertzbeat

EXPOSE 1159
STOPSIGNAL SIGTERM

ENTRYPOINT ["./bin/foreground.sh"]
